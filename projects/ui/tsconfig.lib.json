/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    // ng-packagr maps @gosamply/ui/* to its own build output; the source paths in the root tsconfig are for the IDE and Storybook only.
    "paths": {}
  },
  "include": ["**/src/**/*.ts"],
  "exclude": ["**/*.spec.ts", "stories/**", ".storybook/**"]
}
